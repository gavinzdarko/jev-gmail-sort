{
  "manifest_version": 3,
  "name": "Jev Sort for Gmail",
  "version": "0.2.0",
  "description": "Sort recent Gmail with Jev, or press Alt-Shift-S to correct spelling in your active draft using its writing context.",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:8383/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["https://mail.google.com/*"], "js": ["content.js", "spellcheck.js"], "css": ["content.css", "spellcheck.css"], "run_at": "document_idle" }],
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
}
